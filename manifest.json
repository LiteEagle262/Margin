{
  "manifest_version": 3,
  "name": "ScrapeFlow",
  "version": "1.2.0",
  "description": "OpenRouter AI assistant side panel with page tools and chat history.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "debugger",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open ScrapeFlow"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  }
}
