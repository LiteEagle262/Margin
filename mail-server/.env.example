# Required: the catch-all domain that the AI's temp addresses live on.
# DNS must have an MX record pointing at this server (or you forward via webhook).
MAIL_DOMAIN=mail.example.com

# Required for clients to authenticate against the REST API.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY=change-me

# HTTP API
HTTP_PORT=8080
HTTP_HOST=0.0.0.0

# SMTP receiver. Set SMTP_PORT to empty string to disable and only use webhook ingest.
# Port 25 is privileged; in Docker run with -p 25:25 or use a non-privileged port behind a forwarder.
SMTP_PORT=25
SMTP_HOST=0.0.0.0

# SQLite file location
DB_FILE=./data/mail.db

# Inbox TTL (ms). After expires_at passes, the inbox and its messages are dropped.
DEFAULT_TTL_MS=86400000
MAX_TTL_MS=604800000

# Max accepted mail size in bytes
MAX_MESSAGE_BYTES=10485760

# How often to run the expired-inbox sweeper
CLEANUP_INTERVAL_MS=900000
